[Unit]
Description=Laboratorio Automatizado Hermes proposal engine
After=network-online.target hermes-bridge.service hermes-runtime.service
Wants=network-online.target

[Service]
Type=simple
User=labadmin
Group=labadmin
WorkingDirectory=/srv/labs/projects/lab_automatizado/hermes
EnvironmentFile=/etc/lab-automatizado/hermes.env
ExecStart=/usr/bin/python3 /srv/labs/projects/lab_automatizado/hermes/engine.py
Restart=always
RestartSec=20
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
ReadOnlyPaths=/srv/labs/datasets/canonical /srv/labs/projects/lab_automatizado/hermes/context /srv/labs/projects/lab_automatizado/hermes/reviews/inbox
ReadWritePaths=/srv/labs/projects/lab_automatizado/hermes/proposals /srv/labs/projects/lab_automatizado/hermes/reviews/responses /srv/labs/projects/lab_automatizado/hermes/logs /srv/labs/projects/lab_automatizado/hermes/work

[Install]
WantedBy=multi-user.target
