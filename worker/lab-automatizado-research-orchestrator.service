[Unit]
Description=Laboratorio Automatizado autonomous research scheduler
After=network-online.target lab-automatizado-worker.service hermes-bridge.service hermes-engine.service
Wants=network-online.target

[Service]
Type=simple
User=labadmin
Group=labadmin
WorkingDirectory=/srv/labs/projects/lab_automatizado/worker
EnvironmentFile=/etc/lab-automatizado/worker.env
Environment="ORCHESTRATOR_POLL_SECONDS=30"
ExecStart=/usr/bin/python3 /srv/labs/projects/lab_automatizado/worker/research_orchestrator.py
Restart=always
RestartSec=15
UMask=0002
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
ReadOnlyPaths=/srv/labs/datasets/raw/full
ReadWritePaths=/srv/labs/projects/lab_automatizado/runs/control_plane /srv/labs/projects/lab_automatizado/hermes/context

[Install]
WantedBy=multi-user.target
